my:PExactGeom a geo:Geometry ; geo:asWKT "<http://www.opengis.net/def/crs/EPSG/0/3857> MULTIPOINT ((0 0),(3 4))"^^geo:wktLiteral .

my:Q a geo:Feature ; geo:hasGeometry my:QExactGeom ; geo:hasDefaultGeometry my:QExactGeom .
