@prefix my: <http://example.org/ApplicationSchema#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix sf: <http://www.opengis.net/ont/sf#> .

my:N a geo:Feature ; geo:hasGeometry my:NExactGeom ; geo:hasDefaultGeometry my:NExactGeom .
my:NExactGeom a geo:Geometry ; geo:asWKT "<http://www.opengis.net/def/crs/EPSG/0/3857> POINT Z (2 3 7)"^^geo:wktLiteral .

my:O a geo:Feature ; geo:hasGeometry my:OExactGeom ; geo:hasDefaultGeometry my:OExactGeom .
my:OExactGeom a geo:Geometry ; geo:asWKT "<http://www.opengis.net/def/crs/EPSG/0/3857> LINESTRING Z (0 0 2, 3 4 9)"^^geo:wktLiteral .

