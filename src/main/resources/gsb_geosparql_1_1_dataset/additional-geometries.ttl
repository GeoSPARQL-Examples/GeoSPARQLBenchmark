my:W a geo:Feature ; geo:hasGeometry my:WExactGeom ; geo:hasDefaultGeometry my:WExactGeom .
my:WExactGeom a geo:Geometry ; geo:asWKT "<http://www.opengis.net/def/crs/EPSG/0/3857> MULTIPOLYGON (((0 0,2 0,2 2,0 2,0 0)),((4 0,6 0,6 2,4 2,4 0)))"^^geo:wktLiteral .

