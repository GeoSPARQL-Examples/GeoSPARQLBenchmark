my:T a geo:Feature ; geo:hasGeometry my:TExactGeom ; geo:hasDefaultGeometry my:TExactGeom .
my:TExactGeom a geo:Geometry ; geo:asWKT "<http://www.opengis.net/def/crs/EPSG/0/3857> LINESTRING (0 0,3 4)"^^geo:wktLiteral .

my:U a geo:Feature ; geo:hasGeometry my:UExactGeom ; geo:hasDefaultGeometry my:UExactGeom .
