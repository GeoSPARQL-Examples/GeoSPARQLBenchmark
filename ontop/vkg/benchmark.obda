[PrefixDeclaration]
my:     http://example.org/ApplicationSchema#
geo:    http://www.opengis.net/ont/geosparql#
sf:     http://www.opengis.net/ont/sf#
rdf:    http://www.w3.org/1999/02/22-rdf-syntax-ns#
xsd:    http://www.w3.org/2001/XMLSchema#

[MappingDeclaration] @collection [[

mappingId  iri_1
target     <{s}> my:hasExactGeometry <{o}> .
source     SELECT subject_iri AS s, object_iri AS o
           FROM geobench.iri_fact
           WHERE predicate_iri = 'http://example.org/ApplicationSchema#hasExactGeometry'

