mappingId  lit_30
target     <{s}> geo:asGML "{v}"^^geo:gmlLiteral .
source     SELECT subject_iri AS s, lexical_value AS v
           FROM geobench.literal_fact
           WHERE predicate_iri = 'http://www.opengis.net/ont/geosparql#asGML'
             AND datatype_iri = 'http://www.opengis.net/ont/geosparql#gmlLiteral'
             AND language_tag = ''

